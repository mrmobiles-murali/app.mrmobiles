# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Optional; defaults to the current deployment origin.
# TELEGRAM_MINI_APP_URL=https://mrmobiles.in
# Comma-separated Telegram user IDs. Send /id to the bot to get yours.
TELEGRAM_ADMIN_IDS=
# Optional support chat; defaults to the first admin's private chat.
TELEGRAM_SUPPORT_CHAT_ID=
# Optional custom secret. Omit to keep the SHA256(token) first-32-hex default.
# TELEGRAM_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Supabase - SERVER SIDE ONLY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Keep false until real catalog + webhook are ready
RAZORPAY_PAYMENTS_ENABLED=false
